---
permalink: /calendar/
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Church Calendar | FPC Corinth</title>
<meta name="description" content="Upcoming events at First Presbyterian Church of Corinth, MS, and a calendar feed you can subscribe to">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
<link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#f4f5f1">
<style>
  :root {
    --cream: #f4f5f1; --warm-white: #fdfdfb; --parchment: #eceeea;
    --ink: #171200; --ink-light: #3f3d32; --ink-faint: #666558;
    --rule: #b0af9b; --rule-light: #d9d9cf;
    --accent: #6d8c83; --accent-soft: #8aa39b; --accent-deep: #56736a;
    --gold: #847539; --section-bg: #eef2ef;
  }
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { font-size: 17px; scroll-behavior: smooth; }
  body { font-family: 'EB Garamond', 'Georgia', serif; color: var(--ink); background: var(--parchment); line-height: 1.6; -webkit-font-smoothing: antialiased; min-height: 100vh; }
  .site-header { position: sticky; top: 0; z-index: 100; background: var(--warm-white); border-bottom: 1px solid var(--rule-light); backdrop-filter: saturate(180%) blur(8px); }
  .site-header-inner { max-width: 1040px; margin: 0 auto; padding: 0.7rem 1.4rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .site-header .brand { font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .site-header .archive-link { font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); text-decoration: none; padding: 0.35rem 0.85rem; border: 1px solid var(--rule); border-radius: 2px; white-space: nowrap; margin-left: 0.4rem; }
  .site-header .archive-link:hover { color: var(--warm-white); background: var(--ink); border-color: var(--ink); }
  .page { max-width: 1040px; margin: 0 auto; background: var(--warm-white); min-height: calc(100vh - 3rem); box-shadow: 0 0 80px rgba(23, 18, 0, 0.08); padding: 3rem 1.8rem 4rem; }
  .narrow { max-width: 600px; margin-left: auto; margin-right: auto; }
  @media (min-width: 1041px) { .page { margin-top: 1.5rem; margin-bottom: 1.5rem; border-radius: 2px; } }
  .page-eyebrow { font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent-deep); text-align: center; margin-bottom: 0.6rem; }
  .page-title { font-family: 'Work Sans', sans-serif; font-weight: 300; font-size: 1.8rem; text-align: center; color: var(--ink); line-height: 1.2; }
  .ornament { width: 160px; height: 2px; background: linear-gradient(90deg, transparent, var(--ink), transparent); margin: 1.2rem auto 1.6rem; }
  .subscribe { background: var(--section-bg); border: 1px solid var(--rule-light); border-radius: 3px; padding: 1.2rem 1.3rem; margin-bottom: 2rem; }
  .subscribe h2 { font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-deep); margin-bottom: 0.6rem; }
  .subscribe p { font-size: 0.92rem; color: var(--ink-light); margin-bottom: 0.5rem; }
  .subscribe code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.8rem; background: #fff; border: 1px solid var(--rule-light); padding: 0.1rem 0.35rem; border-radius: 2px; word-break: break-all; }
  .btn { display: inline-block; font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; text-decoration: none; color: var(--warm-white); background: var(--accent); padding: 0.7rem 1.4rem; border-radius: 2px; margin: 0.4rem 0.4rem 0.4rem 0; }
  .btn:hover { background: var(--accent-soft); }
  details summary { cursor: pointer; font-size: 0.9rem; color: var(--accent-deep); margin-top: 0.5rem; }
  details ol { font-size: 0.88rem; color: var(--ink-light); padding-left: 1.2rem; margin: 0.4rem 0 0.6rem; }
  .month { font-family: 'Work Sans', sans-serif; font-weight: 600; font-size: 0.72rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--accent-deep); margin: 1.6rem 0 0.6rem; padding-bottom: 0.3rem; border-bottom: 1px solid var(--rule); }
  .event { display: grid; grid-template-columns: 5.2rem 1fr; gap: 0.2rem 0.8rem; padding: 0.45rem 0; border-bottom: 1px solid var(--rule-light); font-size: 0.92rem; }
  .event .when { color: var(--ink); font-weight: 600; }
  .event .when small { display: block; font-weight: 400; font-size: 0.72rem; color: var(--ink-faint); }
  .event .what { color: var(--ink-light); }
  .event .meta { font-size: 0.8rem; color: var(--ink-faint); font-style: italic; }
  .empty { font-style: italic; color: var(--ink-faint); text-align: center; padding: 2rem 0; }
  .updated { font-size: 0.75rem; color: var(--ink-faint); text-align: center; margin-top: 2rem; }
  @media (max-width: 480px) {
    html { font-size: 16px; }
    .page { padding: 2rem 1.1rem 3rem; }
    .site-header-inner { padding: 0.6rem 1rem; }
    .site-header .brand { font-size: 0.68rem; letter-spacing: 0.1em; }
    .site-header .archive-link { font-size: 0.62rem; letter-spacing: 0.1em; padding: 0.3rem 0.55rem; margin-left: 0.3rem; }
    .page-title { font-size: 1.6rem; }
    .subscribe { padding: 1rem; }
    .btn { display: block; text-align: center; margin: 0.5rem 0 0; }
    .event { grid-template-columns: 6.2rem 1fr; font-size: 0.95rem; }
    .event .when { font-size: 0.9rem; white-space: nowrap; }
  }
  /* ── MONTH VIEW (the same grid as the builder's calendar screen) ── */
  .paper { margin: 0.7rem 0 0 !important; }
  .linklike { font: inherit; color: var(--accent-deep); background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; }
  .quiet { display: inline-block; text-decoration: none; line-height: 1.6; font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-light); background: var(--warm-white); border: 1px solid var(--rule); border-radius: 2px; padding: 0.4rem 0.8rem; cursor: pointer; white-space: nowrap; }
  .quiet:hover { color: var(--warm-white); background: var(--ink); border-color: var(--ink); }
  .viewtabs { display: none; justify-content: center; margin: 0 0 1.4rem; }
  .viewtabs button { border-radius: 0; margin-left: -1px; }
  .viewtabs button:first-child { border-radius: 2px 0 0 2px; margin-left: 0; } .viewtabs button:last-child { border-radius: 0 2px 2px 0; }
  .viewtabs button[aria-pressed="true"] { color: var(--warm-white); background: var(--accent-deep); border-color: var(--accent-deep); position: relative; }
  .calmonth { margin-bottom: 2.4rem; }
  .calhead { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.7rem; flex-wrap: wrap; }
  .calhead h2 { margin: 0 auto 0 0; font-family: 'Work Sans', sans-serif; font-weight: 400; font-size: 1.3rem; color: var(--ink); }
  .calhead button { display: none; } .calhead a.quiet { font-size: 0.68rem; }
  .calgrid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); border-top: 1px solid var(--rule-light); border-left: 1px solid var(--rule-light); font-family: 'Work Sans', sans-serif; }
  .calgrid .dow { font-size: 0.62rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-faint); padding: 0.3rem 0.4rem; border-right: 1px solid var(--rule-light); border-bottom: 1px solid var(--rule-light); }
  .calgrid .day { min-height: 5.6rem; padding: 0.25rem 0.3rem 0.4rem; background: #fff; border-right: 1px solid var(--rule-light); border-bottom: 1px solid var(--rule-light); }
  .calgrid .day.out { background: var(--cream); }
  .calgrid .day.out .ev, .calgrid .day.out .num { opacity: 0.55; }
  .calgrid .num { font-size: 0.72rem; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .calgrid .num .wd { display: none; }
  .calgrid .num b { font-weight: 500; }
  .calgrid .today .num b { background: var(--accent-deep); color: #fff; border-radius: 999px; padding: 0.05rem 0.45rem; }
  .calgrid .ev { margin-top: 0.2rem; padding: 0.15rem 0.35rem; font-size: 0.68rem; line-height: 1.3; color: var(--ink); background: var(--section-bg); border-left: 3px solid var(--accent); border-radius: 3px; overflow-wrap: anywhere; }
  .calgrid .ev.once { background: #f6f1e3; border-left-color: var(--gold); }
  .calgrid .ev .tm { color: var(--ink-faint); } .calgrid .ev .nw { white-space: nowrap; }
  .callegend { font-family: 'Work Sans', sans-serif; font-size: 0.7rem; color: var(--ink-faint); margin: 0.6rem 0 0; }
  .callegend i { display: inline-block; width: 0.7rem; height: 0.7rem; vertical-align: -0.05rem; margin: 0 0.3rem 0 0; border-left: 3px solid var(--accent); background: var(--section-bg); }
  .callegend i.once { border-left-color: var(--gold); background: #f6f1e3; margin-left: 0.9rem; }
  .print-only { display: none; }
  /* with script: one month at a time, and a choice of month or list */
  .js .viewtabs { display: flex; }
  .js .calhead button { display: inline-block; }
  .js .calmonth { display: none; } .js .calmonth.show { display: block; }
  .js.view-month #list-view, .js.view-list #month-view { display: none; }
  @media screen and (max-width: 700px) {
    .calgrid { display: block; border-left: 0; }
    .calgrid .dow, .calgrid .day.noev, .calgrid .day.out { display: none; }
    .calgrid .day { min-height: 0; display: grid; grid-template-columns: 4.2rem minmax(0, 1fr); column-gap: 0.4rem; border-right: 0; padding: 0.45rem 0; background: none; }
    .calgrid .num { grid-column: 1; grid-row: 1 / span 30; font-size: 0.85rem; color: var(--ink); }
    .calgrid .num .wd { display: inline; }
    .calgrid .ev { grid-column: 2; margin: 0 0 0.2rem; font-size: 0.85rem; padding: 0.3rem 0.5rem; }
    .calhead h2 { flex: 1 1 100%; }
  }
  /* ── PRINT: a month to a landscape page ───── */
  @media print {
    html { font-size: 11pt; }
    body { background: #fff; min-height: 0; }
    .site-header, .subscribe, .viewtabs, .calhead button, .calhead a, .updated { display: none !important; }
    .page { max-width: none; margin: 0; padding: 0; box-shadow: none; min-height: 0; background: #fff; }
    .js.view-month .intro { display: none; }
    .print-only { display: block; }
    .printhead { font-family: 'Work Sans', sans-serif; font-size: 7.5pt; letter-spacing: 0.2em; text-transform: uppercase; color: #444; margin-bottom: 0.05in; }
    .printfoot { font-family: 'Work Sans', sans-serif; font-size: 7pt; color: #444; margin-top: 0.05in; }
    .calmonth { break-after: page; margin: 0; }
    .calmonth:last-child, .js .calmonth.show { break-after: auto; }
    .calhead { margin-bottom: 0.08in; } .calhead h2 { font-size: 20pt; font-weight: 300; }
    .calgrid, .calgrid .dow, .calgrid .day { border-color: #999; }
    .calgrid .dow { font-size: 7pt; padding: 0.03in 0.05in; }
    .calgrid .day { min-height: 0.95in; padding: 0.03in 0.05in 0.05in; break-inside: avoid; background: #fff !important; }
    .calgrid .num { font-size: 9pt; color: #000; }
    .calgrid .today .num b { background: none; color: inherit; padding: 0; }
    .calgrid .ev { font-size: 7.5pt; line-height: 1.2; margin-top: 0.03in; padding: 0 0 0 0.05in; background: none !important; border-radius: 0; border-left-width: 2px; }
    .calgrid .ev .tm { color: #333; }
    .callegend { font-size: 7pt; margin-top: 0.06in; color: #444; }
    .callegend i { background: none !important; width: 0.3rem; }
    .event { break-inside: avoid; }
  }
  /* ── SITE MENU ───────────────────────────── */
  .site-nav details { position: relative; }
  .site-nav summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.45rem; font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); padding: 0.35rem 0.85rem; border: 1px solid var(--rule); border-radius: 2px; white-space: nowrap; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease; }
  .site-nav summary::-webkit-details-marker { display: none; }
  .site-nav summary svg { width: 15px; height: 15px; }
  .site-nav summary:hover, .site-nav details[open] summary { color: var(--warm-white); background: var(--ink); border-color: var(--ink); }
  .site-nav .menu-list { position: absolute; right: 0; top: calc(100% + 0.55rem); min-width: 14rem; background: var(--warm-white); border: 1px solid var(--rule-light); border-radius: 3px; box-shadow: 0 14px 36px rgba(23, 18, 0, 0.14); padding: 0.4rem 0; z-index: 200; }
  .site-nav .menu-list a { display: block; padding: 0.6rem 1.15rem; font-family: 'Work Sans', sans-serif; font-size: 0.8rem; letter-spacing: 0.05em; color: var(--ink); text-decoration: none; }
  .site-nav .menu-list a:hover { background: var(--section-bg); color: var(--accent-deep); }
  .site-nav .menu-list a.current { color: var(--accent-deep); font-weight: 600; }
  @media (max-width: 420px) { .site-nav summary { font-size: 0.64rem; padding: 0.3rem 0.7rem; } }
</style>
<style id="landscape" media="print">@page { size: letter landscape; margin: 0.4in 0.45in; }</style>
</head>
<body>

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="https://fpccorinth.org" target="_blank" rel="noopener">First Presbyterian Church</a>
    <nav class="site-nav" aria-label="Site">
      <details>
        <summary><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>Menu</summary>
        <div class="menu-list">
          <a href="/">This Week’s Bulletin</a>
          <a href="/archive/">Past Bulletins</a>
          <a href="/calendar/">Church Calendar</a>
          <a href="/hymns/">Hymn Index</a>
          <a href="/scripture/">Scripture Index</a>
          <a href="/about/">About &amp; Service Times</a>
        </div>
      </details>
    </nav>
  </div>
</header>

<div class="page">
  <div class="intro">
    <p class="page-eyebrow">First Presbyterian Church of Corinth</p>
    <h1 class="page-title">Church Calendar</h1>
    <div class="ornament"></div>
  </div>

  <section class="subscribe narrow">
    <h2>Subscribe on your phone</h2>
    <p>Add the church calendar to your own calendar app once and new events show up by themselves.</p>
    <a class="btn" href="webcal://bulletin.fpccorinth.org/calendar.ics">Subscribe</a>
    <a class="btn" href="https://calendar.google.com/calendar/r?cid=https%3A%2F%2Fbulletin.fpccorinth.org%2Fcalendar.ics" target="_blank" rel="noopener">Add to Google Calendar</a>
    <details>
      <summary>iPhone or iPad</summary>
      <ol>
        <li>Tap <strong>Subscribe</strong> above, then <strong>Subscribe</strong> again in the Calendar prompt.</li>
        <li>If nothing happens, open Settings → Calendar → Accounts → Add Account → Other → Add Subscribed Calendar and paste <code>https://bulletin.fpccorinth.org/calendar.ics</code>.</li>
      </ol>
    </details>
    <details>
      <summary>Google Calendar (Android or web)</summary>
      <ol>
        <li>Tap <strong>Add to Google Calendar</strong> above, or in Google Calendar on the web open Other calendars → <strong>+</strong> → From URL.</li>
        <li>Paste <code>https://bulletin.fpccorinth.org/calendar.ics</code> and choose Add calendar. It will then appear in the Google Calendar app on your phone.</li>
      </ol>
    </details>
    {% if calendarEvents.months %}<p class="paper">Rather have it on paper? {% if calendarEvents.months[0].pdf %}<a class="linklike" id="paperlink" href="{{ calendarEvents.months[0].pdf }}" target="_blank" rel="noopener">Print the month</a>{% else %}<button type="button" class="linklike" data-print>Print the month</button>{% endif %} and put it on the refrigerator. It opens as a one-page sheet, ready to print.</p>{% endif %}
  </section>

  {% if calendarEvents.months %}
  <div class="viewtabs" role="group" aria-label="How to show the calendar">
    <button type="button" class="quiet" data-view="month" aria-pressed="false">Month</button><button type="button" class="quiet" data-view="list" aria-pressed="false">List</button>
  </div>

  <section id="month-view">
    {% for m in calendarEvents.months %}
    <section class="calmonth" data-month="{{ m.month }}" aria-label="{{ m.label }}">
      <p class="print-only printhead">First Presbyterian Church of Corinth · Church Calendar</p>
      <div class="calhead">
        <h2>{{ m.label }}</h2>
        {% if not loop.first %}<button type="button" class="quiet" data-go="{{ calendarEvents.months[loop.index0 - 1].month }}">‹ {{ m.prev_label }}</button>{% endif %}
        {% if not loop.last %}<button type="button" class="quiet" data-go="{{ calendarEvents.months[loop.index0 + 1].month }}">{{ m.next_label }} ›</button>{% endif %}
        {% if m.pdf %}<a class="quiet" href="{{ m.pdf }}" target="_blank" rel="noopener" data-pdf>Print this month</a>
        {% else %}<button type="button" class="quiet" data-print>Print this month</button>{% endif %}
      </div>
      <div class="calgrid">
        {% for name in ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'] %}<div class="dow">{{ name }}</div>{% endfor %}
        {% for week in m.weeks %}{% for day in week %}
        <div class="day{% if not day.in_month %} out{% endif %}{% if day.entries.length == 0 %} noev{% endif %}" data-date="{{ day.date }}">
          <div class="num"><span class="wd">{{ day.weekday }}</span> <b>{{ day.day }}</b></div>
          {% for en in day.entries %}<div class="ev{% if not en.recurring %} once{% endif %}"><span class="t">{{ en.title }}</span>{% if en.time or en.location %} <span class="tm"><span class="nw">{{ en.time }}</span>{% if en.time and en.location %} · {% endif %}{{ en.location }}</span>{% endif %}</div>
          {% endfor %}
        </div>
        {% endfor %}{% endfor %}
      </div>
      <p class="callegend"><i></i>Every week or every month <i class="once"></i>One-time events</p>
      <p class="print-only printfoot">Printed from bulletin.fpccorinth.org/calendar, as it stood on {{ calendarEvents.generated.slice(0, 10) | formatDate }}. Dates and times can change; the page and the subscribed calendar are kept current.</p>
    </section>
    {% endfor %}
  </section>
  {% endif %}

  <section id="list-view" class="narrow">
  {% set evs = calendarEvents.events %}
  {% if evs.length == 0 %}
    <p class="empty">No events are scheduled in the next sixty days.</p>
  {% endif %}
  {% set lastMonth = "" %}
  {% for e in evs %}
    {% if e.month != lastMonth %}
      <p class="month">{{ e.month }}</p>
      {% set lastMonth = e.month %}
    {% endif %}
    <div class="event">
      <div class="when">{{ e.label }}<small>{{ e.weekday }}</small></div>
      <div class="what">{{ e.title }}{% if e.time or e.location %}<div class="meta">{{ e.time }}{% if e.time and e.location %} · {% endif %}{{ e.location }}</div>{% endif %}</div>
    </div>
  {% endfor %}
  </section>

  <p class="updated">Updated {{ calendarEvents.generated.slice(0, 10) }} · <a href="/calendar.ics">calendar.ics</a></p>
</div>

<script>
(function () {
  var d = document.querySelector('.site-nav details');
  if (!d) return;
  document.addEventListener('click', function (e) { if (d.open && !d.contains(e.target)) d.open = false; });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') d.open = false; });
  var p = location.pathname;
  d.querySelectorAll('.menu-list a').forEach(function (a) {
    var h = a.getAttribute('href');
    if (h !== '/' && p.indexOf(h) === 0) a.classList.add('current');
  });
})();
</script>
<script>
// Month view: one month at a time, today marked, and a Month / List switch. "Print this month" is a
// link to that month's one-page landscape PDF (made by the builder); it only prints from here when there is none.
// Without script the page still works: every month shows, one under the other, then the list.
(function () {
  var months = [].slice.call(document.querySelectorAll('.calmonth'));
  if (!months.length) return;
  var root = document.documentElement, now = new Date();
  function pad(n) { return ('0' + n).slice(-2); }
  var thisMonth = now.getFullYear() + '-' + pad(now.getMonth() + 1), today = thisMonth + '-' + pad(now.getDate());
  var paper = document.getElementById('paperlink'), landscape = document.getElementById('landscape');
  function show(month) {
    months.forEach(function (m) {
      var on = m.getAttribute('data-month') === month, pdf = m.querySelector('[data-pdf]');
      m.classList.toggle('show', on);
      if (on && paper && pdf) paper.href = pdf.href; // "Print the month" follows the month on screen
    });
  }
  function view(v) {
    root.classList.remove('view-month', 'view-list');
    root.classList.add('view-' + v);
    if (landscape) landscape.disabled = v !== 'month'; // a printed list stays upright
    document.querySelectorAll('[data-view]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-view') === v)); });
  }
  root.classList.add('js');
  show(months.some(function (m) { return m.getAttribute('data-month') === thisMonth; }) ? thisMonth : months[0].getAttribute('data-month'));
  view(window.matchMedia('(max-width: 700px)').matches ? 'list' : 'month'); // a phone is too narrow for seven columns
  document.querySelectorAll('.day[data-date="' + today + '"]').forEach(function (d) { d.classList.add('today'); });
  document.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('[data-view], [data-go], [data-print]') : null;
    if (!b) return;
    if (b.hasAttribute('data-view')) view(b.getAttribute('data-view'));
    else if (b.hasAttribute('data-go')) show(b.getAttribute('data-go'));
    else { view('month'); window.print(); }
  });
})();
</script>
</body>
</html>
