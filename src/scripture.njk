---
permalink: /scripture/
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Scripture Index | FPC Corinth</title>
<meta name="description" content="Every Scripture passage read in worship at First Presbyterian Church of Corinth, MS: how often, when last, and a link to the text">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
<link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#f4f5f1">
<style>
  :root {
    --cream: #f4f5f1; --warm-white: #fdfdfb; --parchment: #eceeea;
    --ink: #171200; --ink-light: #3f3d32; --ink-faint: #666558;
    --rule: #b0af9b; --rule-light: #d9d9cf;
    --accent: #6d8c83; --accent-soft: #8aa39b; --accent-deep: #56736a;
    --gold: #847539; --section-bg: #eef2ef;
  }
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { font-size: 17px; scroll-behavior: smooth; }
  body { font-family: 'EB Garamond', 'Georgia', serif; color: var(--ink); background: var(--parchment); line-height: 1.6; -webkit-font-smoothing: antialiased; min-height: 100vh; }
  .site-header { position: sticky; top: 0; z-index: 100; background: var(--warm-white); border-bottom: 1px solid var(--rule-light); backdrop-filter: saturate(180%) blur(8px); }
  .site-header-inner { max-width: 720px; margin: 0 auto; padding: 0.7rem 1.4rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .site-header .brand { font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .site-header .archive-link { font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); text-decoration: none; padding: 0.35rem 0.85rem; border: 1px solid var(--rule); border-radius: 2px; white-space: nowrap; margin-left: 0.4rem; }
  .site-header .archive-link:hover { color: var(--warm-white); background: var(--ink); border-color: var(--ink); }
  .page { max-width: 720px; margin: 0 auto; background: var(--warm-white); min-height: calc(100vh - 3rem); box-shadow: 0 0 80px rgba(23, 18, 0, 0.08); padding: 3rem 1.8rem 4rem; }
  @media (min-width: 721px) { .page { margin-top: 1.5rem; margin-bottom: 1.5rem; border-radius: 2px; } }
  .page-eyebrow { font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent-deep); text-align: center; margin-bottom: 0.6rem; }
  .page-title { font-family: 'Work Sans', sans-serif; font-weight: 300; font-size: 1.8rem; text-align: center; color: var(--ink); line-height: 1.2; }
  .ornament { width: 160px; height: 2px; background: linear-gradient(90deg, transparent, var(--ink), transparent); margin: 1.2rem auto 1.6rem; }
  .intro { font-size: 0.92rem; color: var(--ink-light); text-align: center; margin-bottom: 1.4rem; }
  .intro a { color: var(--accent-deep); }
  .sort { display: flex; align-items: center; gap: 0.35rem; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 0.2rem 0 0.8rem; margin: 0 -1.8rem 0.6rem; padding-left: 1.8rem; padding-right: 1.8rem; }
  .sort::-webkit-scrollbar { display: none; }
  .sort span { font-family: 'Work Sans', sans-serif; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); white-space: nowrap; margin-right: 0.2rem; }
  .sort button { font-family: 'Work Sans', sans-serif; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-deep); background: none; border: 1px solid var(--rule-light); border-radius: 999px; padding: 0.4rem 0.85rem; cursor: pointer; white-space: nowrap; -webkit-tap-highlight-color: transparent; }
  .sort button[aria-pressed="true"] { color: var(--warm-white); background: var(--accent); border-color: var(--accent); }
  .list { border-top: 1px solid var(--rule); }
  .book { font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent-deep); padding: 1.1rem 0 0.3rem; border-bottom: 1px solid var(--rule-light); }
  .book small { font-weight: 400; letter-spacing: 0.05em; text-transform: none; color: var(--ink-faint); margin-left: 0.5rem; }
  .list.flat .book { display: none; }
  .passage[hidden], .book[hidden] { display: none; }
  .filter { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.9rem; font-family: 'Work Sans', sans-serif; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); }
  .filter select { font-family: 'Work Sans', sans-serif; font-size: 0.78rem; color: var(--ink); background: var(--warm-white); border: 1px solid var(--rule-light); border-radius: 3px; padding: 0.35rem 0.5rem; max-width: 16rem; }
  .passage { display: grid; grid-template-columns: 1fr; grid-template-areas: "title" "meta" "dates"; column-gap: 0.6rem; padding: 0.8rem 0; border-bottom: 1px solid var(--rule-light); }
  .passage .num { grid-area: num; font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.95rem; color: var(--accent-deep); padding-top: 0.15rem; }
  .passage .title { grid-area: title; font-size: 1.05rem; line-height: 1.35; }
  .passage .title a { color: var(--ink); text-decoration: none; }
  .passage .title a::after { content: " ↗"; font-size: 0.7em; color: var(--rule); }
  .passage .title small { display: block; font-size: 0.8rem; color: var(--ink-faint); font-style: italic; margin-top: 0.1rem; }
  .passage .meta { grid-area: meta; font-family: 'Work Sans', sans-serif; font-size: 0.74rem; letter-spacing: 0.02em; color: var(--ink-faint); margin-top: 0.3rem; display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; align-items: baseline; }
  .passage .meta b { font-weight: 600; color: var(--ink-light); }
  .passage .meta .tune { letter-spacing: 0.04em; }
  .passage .meta button { font: inherit; letter-spacing: inherit; color: var(--accent-deep); background: none; border: 0; padding: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .passage .meta button::after { content: " ▾"; font-size: 0.8em; }
  .passage.open .meta button::after { content: " ▴"; }
  .passage .dates { grid-area: dates; display: none; font-size: 0.86rem; color: var(--ink-light); margin-top: 0.5rem; padding: 0.5rem 0.8rem; background: var(--section-bg); border-radius: 3px; }
  .passage.open .dates { display: block; }
  .passage .dates div { padding: 0.15rem 0; }
  .passage .dates a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--rule); }
  .passage .dates span { color: var(--ink-faint); }
  @media (min-width: 600px) {
    .passage { grid-template-columns: 1fr 10rem 3.5rem; grid-template-areas: "title tune sung" "meta tune sung" "dates dates dates"; align-items: start; }
    .passage .title { font-size: 1rem; }
    .passage .meta .tune { display: none; }
    .passage .tunecol { grid-area: tune; font-family: 'Work Sans', sans-serif; font-size: 0.72rem; letter-spacing: 0.04em; color: var(--ink-faint); padding-top: 0.3rem; }
    .passage .sungcol { grid-area: sung; font-family: 'Work Sans', sans-serif; font-size: 0.95rem; color: var(--ink-light); text-align: right; padding-top: 0.15rem; }
    .passage .meta .sung { display: none; }
  }
  @media (max-width: 599px) { .passage .tunecol, .passage .sungcol { display: none; } }
  .note { font-size: 0.85rem; color: var(--ink-faint); margin-top: 1.6rem; }
  .updated { font-size: 0.75rem; color: var(--ink-faint); text-align: center; margin-top: 2rem; }
  @media (max-width: 480px) {
    html { font-size: 16px; }
    .page { padding: 2rem 1.1rem 3rem; }
    .sort { margin: 0 -1.1rem 0.6rem; padding-left: 1.1rem; padding-right: 1.1rem; }
    .site-header-inner { padding: 0.6rem 1rem; }
    .site-header .brand { font-size: 0.68rem; letter-spacing: 0.1em; }
    .site-header .archive-link { font-size: 0.62rem; letter-spacing: 0.1em; padding: 0.3rem 0.55rem; margin-left: 0.3rem; }
    .page-title { font-size: 1.6rem; }
    .intro { text-align: left; font-size: 0.95rem; }
  }
  /* ── SITE MENU ───────────────────────────── */
  .site-nav details { position: relative; }
  .site-nav summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.45rem; font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); padding: 0.35rem 0.85rem; border: 1px solid var(--rule); border-radius: 2px; white-space: nowrap; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease; }
  .site-nav summary::-webkit-details-marker { display: none; }
  .site-nav summary svg { width: 15px; height: 15px; }
  .site-nav summary:hover, .site-nav details[open] summary { color: var(--warm-white); background: var(--ink); border-color: var(--ink); }
  .site-nav .menu-list { position: absolute; right: 0; top: calc(100% + 0.55rem); min-width: 14rem; background: var(--warm-white); border: 1px solid var(--rule-light); border-radius: 3px; box-shadow: 0 14px 36px rgba(23, 18, 0, 0.14); padding: 0.4rem 0; z-index: 200; }
  .site-nav .menu-list a { display: block; padding: 0.6rem 1.15rem; font-family: 'Work Sans', sans-serif; font-size: 0.8rem; letter-spacing: 0.05em; color: var(--ink); text-decoration: none; }
  .site-nav .menu-list a:hover { background: var(--section-bg); color: var(--accent-deep); }
  .site-nav .menu-list a.current { color: var(--accent-deep); font-weight: 600; }
  @media (max-width: 420px) { .site-nav summary { font-size: 0.64rem; padding: 0.3rem 0.7rem; } }
</style>
</head>
<body>

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="https://fpccorinth.org" target="_blank" rel="noopener">First Presbyterian Church</a>
    <nav class="site-nav" aria-label="Site">
      <details>
        <summary><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>Menu</summary>
        <div class="menu-list">
          <a href="/">This Week’s Bulletin</a>
          <a href="/archive/">Past Bulletins</a>
          <a href="/calendar/">Church Calendar</a>
          <a href="/hymns/">Hymn Index</a>
          <a href="/scripture/">Scripture Index</a>
          <a href="/about/">About &amp; Service Times</a>
        </div>
      </details>
    </nav>
  </div>
</header>

<div class="page">
  <p class="page-eyebrow">First Presbyterian Church of Corinth</p>
  <h1 class="page-title">Scripture Index</h1>
  <div class="ornament"></div>

  <p class="intro">{{ scriptureIndex.passages.length }} passages from {{ scriptureIndex.books.length }} books of the Bible, read at {{ scriptureIndex.services }} services since {{ scriptureIndex.since_label }}: the sermon text, the calls to worship and meditation, the assurance of pardon, and the other readings printed in the bulletin. A reference opens the passage ({{ scriptureIndex.version }}) on Bible Gateway; “every date” opens the services it was read at.</p>

  <div class="sort" role="group" aria-label="Sort passages">
    <span>Sort</span>
    <button type="button" data-sort="bible" aria-pressed="true">Bible order</button>
    <button type="button" data-sort="times" aria-pressed="false">Most read</button>
    <button type="button" data-sort="last" aria-pressed="false">Most recent</button>
  </div>
  <div class="filter">
    <label for="book">Book</label>
    <select id="book">
      <option value="">All books</option>
      {% for b in scriptureIndex.books %}<option value="{{ b.book }}">{{ b.book }} ({{ b.passages }})</option>{% endfor %}
    </select>
  </div>

  <div class="list" id="passages">
    {% set lastBook = "" %}
    {% for p in scriptureIndex.passages %}
    {% if p.book != lastBook %}{% set lastBook = p.book %}
    <h2 class="book" data-book="{{ p.book }}">{{ p.book }}{% for b in scriptureIndex.books %}{% if b.book == p.book %}<small>{{ b.passages }} passage{% if b.passages != 1 %}s{% endif %}</small>{% endif %}{% endfor %}</h2>
    {% endif %}
    <article class="passage" data-order="{{ loop.index }}" data-times="{{ p.times }}" data-last="{{ p.last }}" data-book="{{ p.book }}">
      <div class="title"><a href="{{ p.url }}" target="_blank" rel="noopener" title="Read on Bible Gateway">{{ p.ref }}</a>{% if p.pew_page %}<small>Pew Bible, p. {{ p.pew_page }}</small>{% endif %}</div>
      <div class="tunecol">{{ p.slots | join(" · ") }}</div>
      <div class="sungcol" title="Times read">{{ p.times }}×</div>
      <div class="meta">
        <span class="sung">Read <b>{{ p.times }}</b></span>
        <span>Last <b>{{ p.last_label }}</b></span>
        <span class="tune">{{ p.slots | join(" · ") }}</span>
        <button type="button" aria-expanded="false">{{ "every date" if p.times > 1 else "details" }}</button>
      </div>
      <div class="dates">{% for d in p.dates | reverse %}<div><a href="/scroll/{{ d.date }}/">{{ d.label }}</a> <span>· {{ d.slot }}{% if d.note %}, {{ d.note }} the passage{% endif %}{% if d.version %} ({{ d.version }}){% endif %}</span></div>{% endfor %}</div>
    </article>
    {% endfor %}
  </div>

  {% if scriptureIndex.unparsed.length %}
  <p class="note">Readings printed without a reference: {% for u in scriptureIndex.unparsed %}{{ u.slot }} {{ u.text }} ({{ u.date }}){% if not loop.last %}; {% endif %}{% endfor %}.</p>
  {% endif %}

  <p class="updated">Updated {{ scriptureIndex.generated.slice(0, 10) }} · through {{ scriptureIndex.through_label }}</p>
</div>

<script>
(function () {
  var list = document.getElementById('passages');
  var rows = Array.prototype.slice.call(list.querySelectorAll('.passage'));
  var heads = Array.prototype.slice.call(list.querySelectorAll('.book'));
  var select = document.getElementById('book');
  function byOrder(a, b) { return parseInt(a.dataset.order, 10) - parseInt(b.dataset.order, 10); }
  var sorters = {
    bible: byOrder,
    times: function (a, b) { return (parseInt(b.dataset.times, 10) - parseInt(a.dataset.times, 10)) || byOrder(a, b); },
    last: function (a, b) { return (b.dataset.last < a.dataset.last ? -1 : b.dataset.last > a.dataset.last ? 1 : 0) || byOrder(a, b); }
  };
  var mode = 'bible';
  function render() {
    var book = select.value;
    if (mode === 'bible') {
      list.classList.remove('flat');
      heads.forEach(function (h) {
        list.appendChild(h);
        h.hidden = !!book && h.dataset.book !== book;
        rows.filter(function (r) { return r.dataset.book === h.dataset.book; }).forEach(function (r) { list.appendChild(r); });
      });
    } else {
      list.classList.add('flat');
      rows.slice().sort(sorters[mode]).forEach(function (r) { list.appendChild(r); });
    }
    rows.forEach(function (r) { r.hidden = !!book && r.dataset.book !== book; });
  }
  document.querySelectorAll('.sort button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.sort button').forEach(function (b) { b.setAttribute('aria-pressed', String(b === btn)); });
      mode = btn.dataset.sort;
      render();
      window.scrollTo({ top: list.getBoundingClientRect().top + window.pageYOffset - 80, behavior: 'smooth' });
    });
  });
  select.addEventListener('change', render);
  list.addEventListener('click', function (e) {
    var btn = e.target.closest('.meta button');
    if (!btn) return;
    var row = btn.closest('.passage');
    var open = row.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });
})();
</script>
<script>
(function () {
  var d = document.querySelector('.site-nav details');
  if (!d) return;
  document.addEventListener('click', function (e) { if (d.open && !d.contains(e.target)) d.open = false; });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') d.open = false; });
  var p = location.pathname;
  d.querySelectorAll('.menu-list a').forEach(function (a) {
    var h = a.getAttribute('href');
    if (h !== '/' && p.indexOf(h) === 0) a.classList.add('current');
  });
})();
</script>
</body>
</html>
