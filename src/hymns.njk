---
permalink: /hymns/
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hymn Index | FPC Corinth</title>
<meta name="description" content="Every hymn sung at First Presbyterian Church of Corinth, MS: how often, when last, and a link to the words">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
<link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#f4f5f1">
<style>
  :root {
    --cream: #f4f5f1; --warm-white: #fdfdfb; --parchment: #eceeea;
    --ink: #171200; --ink-light: #3f3d32; --ink-faint: #666558;
    --rule: #b0af9b; --rule-light: #d9d9cf;
    --accent: #6d8c83; --accent-soft: #8aa39b; --accent-deep: #56736a;
    --gold: #847539; --section-bg: #eef2ef;
  }
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { font-size: 17px; scroll-behavior: smooth; }
  body { font-family: 'EB Garamond', 'Georgia', serif; color: var(--ink); background: var(--parchment); line-height: 1.6; -webkit-font-smoothing: antialiased; min-height: 100vh; }
  .site-header { position: sticky; top: 0; z-index: 100; background: var(--warm-white); border-bottom: 1px solid var(--rule-light); backdrop-filter: saturate(180%) blur(8px); }
  .site-header-inner { max-width: 720px; margin: 0 auto; padding: 0.7rem 1.4rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .site-header .brand { font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .site-header .archive-link { font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); text-decoration: none; padding: 0.35rem 0.85rem; border: 1px solid var(--rule); border-radius: 2px; white-space: nowrap; margin-left: 0.4rem; }
  .site-header .archive-link:hover { color: var(--warm-white); background: var(--ink); border-color: var(--ink); }
  .page { max-width: 720px; margin: 0 auto; background: var(--warm-white); min-height: calc(100vh - 3rem); box-shadow: 0 0 80px rgba(23, 18, 0, 0.08); padding: 3rem 1.8rem 4rem; }
  @media (min-width: 721px) { .page { margin-top: 1.5rem; margin-bottom: 1.5rem; border-radius: 2px; } }
  .page-eyebrow { font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent-deep); text-align: center; margin-bottom: 0.6rem; }
  .page-title { font-family: 'Work Sans', sans-serif; font-weight: 300; font-size: 1.8rem; text-align: center; color: var(--ink); line-height: 1.2; }
  .ornament { width: 160px; height: 2px; background: linear-gradient(90deg, transparent, var(--ink), transparent); margin: 1.2rem auto 1.6rem; }
  .intro { font-size: 0.92rem; color: var(--ink-light); text-align: center; margin-bottom: 1.4rem; }
  .intro a { color: var(--accent-deep); }
  .sort { display: flex; align-items: center; gap: 0.35rem; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 0.2rem 0 0.8rem; margin: 0 -1.8rem 0.6rem; padding-left: 1.8rem; padding-right: 1.8rem; }
  .sort::-webkit-scrollbar { display: none; }
  .sort span { font-family: 'Work Sans', sans-serif; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); white-space: nowrap; margin-right: 0.2rem; }
  .sort button { font-family: 'Work Sans', sans-serif; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-deep); background: none; border: 1px solid var(--rule-light); border-radius: 999px; padding: 0.4rem 0.85rem; cursor: pointer; white-space: nowrap; -webkit-tap-highlight-color: transparent; }
  .sort button[aria-pressed="true"] { color: var(--warm-white); background: var(--accent); border-color: var(--accent); }
  .list { border-top: 1px solid var(--rule); }
  .hymn { display: grid; grid-template-columns: 2.6rem 1fr; grid-template-areas: "num title" "num meta" "num dates"; column-gap: 0.6rem; padding: 0.8rem 0; border-bottom: 1px solid var(--rule-light); }
  .hymn .num { grid-area: num; font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.95rem; color: var(--accent-deep); padding-top: 0.15rem; }
  .hymn .title { grid-area: title; font-size: 1.05rem; line-height: 1.35; }
  .hymn .title a { color: var(--ink); text-decoration: none; }
  .hymn .title a::after { content: " ↗"; font-size: 0.7em; color: var(--rule); }
  .hymn .title small { display: block; font-size: 0.8rem; color: var(--ink-faint); font-style: italic; margin-top: 0.1rem; }
  .hymn .meta { grid-area: meta; font-family: 'Work Sans', sans-serif; font-size: 0.74rem; letter-spacing: 0.02em; color: var(--ink-faint); margin-top: 0.3rem; display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; align-items: baseline; }
  .hymn .meta b { font-weight: 600; color: var(--ink-light); }
  .hymn .meta .tune { font-variant: small-caps; letter-spacing: 0.08em; }
  .hymn .meta button { font: inherit; letter-spacing: inherit; color: var(--accent-deep); background: none; border: 0; padding: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .hymn .meta button::after { content: " ▾"; font-size: 0.8em; }
  .hymn.open .meta button::after { content: " ▴"; }
  .hymn .dates { grid-area: dates; display: none; font-size: 0.86rem; color: var(--ink-light); margin-top: 0.5rem; padding: 0.5rem 0.8rem; background: var(--section-bg); border-radius: 3px; }
  .hymn.open .dates { display: block; }
  .hymn .dates div { padding: 0.15rem 0; }
  .hymn .dates a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--rule); }
  .hymn .dates span { color: var(--ink-faint); }
  @media (min-width: 600px) {
    .hymn { grid-template-columns: 3rem 1fr 8rem 3.5rem; grid-template-areas: "num title tune sung" "num meta tune sung" "num dates dates dates"; align-items: start; }
    .hymn .title { font-size: 1rem; }
    .hymn .meta .tune { display: none; }
    .hymn .tunecol { grid-area: tune; font-family: 'Work Sans', sans-serif; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); padding-top: 0.3rem; }
    .hymn .sungcol { grid-area: sung; font-family: 'Work Sans', sans-serif; font-size: 0.95rem; color: var(--ink-light); text-align: right; padding-top: 0.15rem; }
    .hymn .meta .sung { display: none; }
  }
  @media (max-width: 599px) { .hymn .tunecol, .hymn .sungcol { display: none; } }
  .note { font-size: 0.85rem; color: var(--ink-faint); margin-top: 1.6rem; }
  .updated { font-size: 0.75rem; color: var(--ink-faint); text-align: center; margin-top: 2rem; }
  @media (max-width: 480px) {
    html { font-size: 16px; }
    .page { padding: 2rem 1.1rem 3rem; }
    .sort { margin: 0 -1.1rem 0.6rem; padding-left: 1.1rem; padding-right: 1.1rem; }
    .site-header-inner { padding: 0.6rem 1rem; }
    .site-header .brand { font-size: 0.68rem; letter-spacing: 0.1em; }
    .site-header .archive-link { font-size: 0.62rem; letter-spacing: 0.1em; padding: 0.3rem 0.55rem; margin-left: 0.3rem; }
    .page-title { font-size: 1.6rem; }
    .intro { text-align: left; font-size: 0.95rem; }
  }
  /* ── SITE MENU ───────────────────────────── */
  .site-nav details { position: relative; }
  .site-nav summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.45rem; font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); padding: 0.35rem 0.85rem; border: 1px solid var(--rule); border-radius: 2px; white-space: nowrap; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease; }
  .site-nav summary::-webkit-details-marker { display: none; }
  .site-nav summary svg { width: 15px; height: 15px; }
  .site-nav summary:hover, .site-nav details[open] summary { color: var(--warm-white); background: var(--ink); border-color: var(--ink); }
  .site-nav .menu-list { position: absolute; right: 0; top: calc(100% + 0.55rem); min-width: 14rem; background: var(--warm-white); border: 1px solid var(--rule-light); border-radius: 3px; box-shadow: 0 14px 36px rgba(23, 18, 0, 0.14); padding: 0.4rem 0; z-index: 200; }
  .site-nav .menu-list a { display: block; padding: 0.6rem 1.15rem; font-family: 'Work Sans', sans-serif; font-size: 0.8rem; letter-spacing: 0.05em; color: var(--ink); text-decoration: none; }
  .site-nav .menu-list a:hover { background: var(--section-bg); color: var(--accent-deep); }
  .site-nav .menu-list a.current { color: var(--accent-deep); font-weight: 600; }
  @media (max-width: 420px) { .site-nav summary { font-size: 0.64rem; padding: 0.3rem 0.7rem; } }
</style>
</head>
<body>

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="https://fpccorinth.org" target="_blank" rel="noopener">First Presbyterian Church</a>
    <nav class="site-nav" aria-label="Site">
      <details>
        <summary><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>Menu</summary>
        <div class="menu-list">
          <a href="/">This Week’s Bulletin</a>
          <a href="/archive/">Past Bulletins</a>
          <a href="/calendar/">Church Calendar</a>
          <a href="/hymns/">Hymn Index</a>
          <a href="/about/">About &amp; Service Times</a>
        </div>
      </details>
    </nav>
  </div>
</header>

<div class="page">
  <p class="page-eyebrow">First Presbyterian Church of Corinth</p>
  <h1 class="page-title">Hymn Index</h1>
  <div class="ornament"></div>

  <p class="intro">{{ hymnIndex.hymns.length }} hymns sung at {{ hymnIndex.services }} services since {{ hymnIndex.since_label }}, from <a href="{{ hymnIndex.hymnary_hymnal_url }}" target="_blank" rel="noopener">{{ hymnIndex.hymnal }}</a>. A title opens the words on Hymnary.org; a “last sung” date opens every date.</p>

  <div class="sort" role="group" aria-label="Sort hymns">
    <span>Sort</span>
    <button type="button" data-sort="number" aria-pressed="true">Number</button>
    <button type="button" data-sort="times" aria-pressed="false">Most sung</button>
    <button type="button" data-sort="last" aria-pressed="false">Most recent</button>
    <button type="button" data-sort="title" aria-pressed="false">Title</button>
  </div>

  <div class="list" id="hymns">
    {% for h in hymnIndex.hymns %}
    <article class="hymn" data-number="{{ h.number }}" data-times="{{ h.times }}" data-last="{{ h.last }}" data-title="{{ h.title | lower }}">
      <div class="num">{{ h.number }}</div>
      <div class="title"><a href="{{ h.url }}" target="_blank" rel="noopener" title="Words on Hymnary.org">{{ h.title }}</a>{% if h.as_printed.length %}<small>printed as {{ h.as_printed | join(" / ") }}</small>{% endif %}{% if not h.in_hymnal %}<small>not a number in the hymnal</small>{% endif %}</div>
      <div class="tunecol">{{ h.tune or "" }}</div>
      <div class="sungcol" title="Times sung">{{ h.times }}×</div>
      <div class="meta">
        <span class="sung">Sung <b>{{ h.times }}</b></span>
        <span>Last <b>{{ h.last_label }}</b></span>
        {% if h.tune %}<span class="tune">{{ h.tune | lower }}</span>{% endif %}
        <button type="button" aria-expanded="false">{{ "every date" if h.times > 1 else "details" }}</button>
      </div>
      <div class="dates">{% for d in h.dates | reverse %}<div><a href="/scroll/{{ d.date }}/">{{ d.label }}</a> <span>· {{ d.slot }}{% if d.verses %} ({{ d.verses }}){% endif %}</span></div>{% endfor %}</div>
    </article>
    {% endfor %}
  </div>

  {% if hymnIndex.unnumbered.length %}
  <p class="note">Sung without a hymnal number: {% for u in hymnIndex.unnumbered %}“{{ u.title }}” ({{ u.date }}){% if not loop.last %}; {% endif %}{% endfor %}.</p>
  {% endif %}

  <p class="updated">Updated {{ hymnIndex.generated.slice(0, 10) }} · through {{ hymnIndex.through_label }}</p>
</div>

<script>
(function () {
  var list = document.getElementById('hymns');
  var rows = Array.prototype.slice.call(list.children);
  function byNumber(a, b) { return parseInt(a.dataset.number, 10) - parseInt(b.dataset.number, 10); }
  var sorters = {
    number: byNumber,
    times: function (a, b) { return (parseInt(b.dataset.times, 10) - parseInt(a.dataset.times, 10)) || byNumber(a, b); },
    last: function (a, b) { return (b.dataset.last < a.dataset.last ? -1 : b.dataset.last > a.dataset.last ? 1 : 0) || byNumber(a, b); },
    title: function (a, b) { return a.dataset.title < b.dataset.title ? -1 : a.dataset.title > b.dataset.title ? 1 : 0; }
  };
  document.querySelectorAll('.sort button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.sort button').forEach(function (b) { b.setAttribute('aria-pressed', String(b === btn)); });
      rows.sort(sorters[btn.dataset.sort]);
      rows.forEach(function (r) { list.appendChild(r); });
      window.scrollTo({ top: list.getBoundingClientRect().top + window.pageYOffset - 80, behavior: 'smooth' });
    });
  });
  list.addEventListener('click', function (e) {
    var btn = e.target.closest('.meta button');
    if (!btn) return;
    var row = btn.closest('.hymn');
    var open = row.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });
})();
</script>
<script>
(function () {
  var d = document.querySelector('.site-nav details');
  if (!d) return;
  document.addEventListener('click', function (e) { if (d.open && !d.contains(e.target)) d.open = false; });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') d.open = false; });
  var p = location.pathname;
  d.querySelectorAll('.menu-list a').forEach(function (a) {
    var h = a.getAttribute('href');
    if (h !== '/' && p.indexOf(h) === 0) a.classList.add('current');
  });
})();
</script>
</body>
</html>
