---
permalink: /archive/
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bulletin Archive | FPC Corinth</title>
<meta name="description" content="Past Sunday bulletins for First Presbyterian Church of Corinth, MS">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
<link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#f4f5f1">
<style>
  :root {
    --cream: #f4f5f1;
    --warm-white: #fdfdfb;
    --parchment: #eceeea;
    --ink: #171200;
    --ink-light: #3f3d32;
    --ink-faint: #666558;
    --rule: #b0af9b;
    --rule-light: #d9d9cf;
    --accent: #6d8c83;
    --accent-soft: #8aa39b;
    --accent-deep: #56736a;
    --gold: #847539;
    --section-bg: #eef2ef;
  }

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  html { font-size: 17px; scroll-behavior: smooth; }

  body {
    font-family: 'EB Garamond', 'Georgia', serif;
    color: var(--ink);
    background: var(--parchment);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 999;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  }

  /* ── SITE HEADER (matches scroll bulletin) ─ */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--warm-white);
    border-bottom: 1px solid var(--rule-light);
    backdrop-filter: saturate(180%) blur(8px);
  }
  .site-header-inner {
    max-width: 640px;
    margin: 0 auto;
    padding: 0.7rem 1.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .site-header .brand {
    font-family: 'Work Sans', sans-serif;
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .site-header .brand:hover { color: var(--accent-deep); }
  .site-header .home-link {
    font-family: 'Work Sans', sans-serif;
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    white-space: nowrap;
  }
  .site-header .home-link:hover {
    color: var(--warm-white);
    background: var(--ink);
    border-color: var(--ink);
  }
  @media (max-width: 420px) {
    .site-header .brand { font-size: 0.68rem; letter-spacing: 0.1em; }
    .site-header .home-link { font-size: 0.64rem; padding: 0.3rem 0.7rem; }
    .site-header-inner { padding: 0.6rem 1rem; }
  }

  /* ── PAGE CONTAINER ──────────────────────── */
  .page {
    max-width: 640px;
    margin: 0 auto;
    background: var(--warm-white);
    min-height: calc(100vh - 3rem);
    box-shadow: 0 0 80px rgba(23, 18, 0, 0.08);
    padding: 3rem 1.8rem 4rem;
    position: relative;
  }
  @media (min-width: 641px) {
    .page {
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
      border-radius: 2px;
    }
  }

  /* ── HEADING ─────────────────────────────── */
  .page-eyebrow {
    font-family: 'Work Sans', sans-serif;
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-deep);
    text-align: center;
    margin-bottom: 0.8rem;
  }
  .page-title {
    font-family: 'Work Sans', sans-serif;
    font-weight: 300;
    font-size: clamp(1.8rem, 6vw, 2.4rem);
    text-align: center;
    color: var(--ink);
    margin-bottom: 0.5rem;
    letter-spacing: 0.01em;
  }
  .ornament {
    width: 160px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--ink), transparent);
    margin: 1rem auto 2rem;
  }
  .page-sub {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 1rem;
    color: var(--ink-faint);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  /* ── ARCHIVE LIST ────────────────────────── */
  .archive-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .archive-item {
    display: block;
    padding: 1.1rem 1.3rem;
    background: var(--warm-white);
    border: 1px solid var(--rule-light);
    border-left: 3px solid var(--rule);
    border-radius: 2px;
    text-decoration: none;
    color: inherit;
    transition: border-left-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    position: relative;
  }
  .archive-item:hover {
    border-left-color: var(--accent-deep);
    box-shadow: 0 4px 16px rgba(23, 18, 0, 0.08);
    transform: translateY(-1px);
  }

  .archive-date {
    font-family: 'EB Garamond', serif;
    font-weight: 500;
    font-size: 1.15rem;
    color: var(--ink);
    margin-bottom: 0.15rem;
  }
  .archive-day {
    font-family: 'Work Sans', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: 0.35rem;
  }
  .archive-sermon {
    font-size: 0.92rem;
    font-style: italic;
    color: var(--ink-light);
    line-height: 1.45;
  }
  .archive-listen {
    display: inline-block;
    margin: 0.5rem 0 0 1.3rem;
    font-family: 'Work Sans', sans-serif;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-deep);
    text-decoration: none;
    border: 1px solid var(--rule-light);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }
  .archive-listen-app { margin-left: 0.4rem; border-color: transparent; color: var(--ink-faint); white-space: nowrap; }
  .app-icon { width: 1.25em; height: 1.25em; vertical-align: -0.3em; margin-right: 0.3em; fill: currentColor; }
  .app-icon-applepodcasts { color: #b150e2; }
  .app-icon-spotify { color: #1db954; }
  .app-icon-youtube { color: #ff0000; }
  .archive-listen:hover .app-icon { color: inherit; }
  .archive-listen:hover { color: var(--warm-white); background: var(--accent); border-color: var(--accent); }
  .archive-arrow {
    position: absolute;
    right: 1.3rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: 'EB Garamond', serif;
    color: var(--rule);
    font-size: 1.4rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .archive-item:hover .archive-arrow {
    color: var(--accent-deep);
    transform: translateY(-50%) translateX(3px);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--ink-faint);
    font-style: italic;
  }

  /* ── FOOTER ──────────────────────────────── */
  .page-footer {
    text-align: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule-light);
    font-family: 'EB Garamond', serif;
    font-size: 0.85rem;
    color: var(--ink-faint);
    font-style: italic;
  }
  .page-footer a {
    color: var(--accent-deep);
    text-decoration: none;
  }
  .page-footer a:hover { text-decoration: underline; }

  @media (max-width: 500px) {
    .page { padding: 2rem 1.3rem 3rem; }
    .archive-item { padding: 0.95rem 2.5rem 0.95rem 1.1rem; }
    .archive-arrow { right: 1rem; }
  }
  /* ── SITE MENU ───────────────────────────── */
  .site-nav details { position: relative; }
  .site-nav summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.45rem; font-family: 'Work Sans', sans-serif; font-weight: 500; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint); padding: 0.35rem 0.85rem; border: 1px solid var(--rule); border-radius: 2px; white-space: nowrap; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease; }
  .site-nav summary::-webkit-details-marker { display: none; }
  .site-nav summary svg { width: 15px; height: 15px; }
  .site-nav summary:hover, .site-nav details[open] summary { color: var(--warm-white); background: var(--ink); border-color: var(--ink); }
  .site-nav .menu-list { position: absolute; right: 0; top: calc(100% + 0.55rem); min-width: 14rem; background: var(--warm-white); border: 1px solid var(--rule-light); border-radius: 3px; box-shadow: 0 14px 36px rgba(23, 18, 0, 0.14); padding: 0.4rem 0; z-index: 200; }
  .site-nav .menu-list a { display: block; padding: 0.6rem 1.15rem; font-family: 'Work Sans', sans-serif; font-size: 0.8rem; letter-spacing: 0.05em; color: var(--ink); text-decoration: none; }
  .site-nav .menu-list a:hover { background: var(--section-bg); color: var(--accent-deep); }
  .site-nav .menu-list a.current { color: var(--accent-deep); font-weight: 600; }
  @media (max-width: 420px) { .site-nav summary { font-size: 0.64rem; padding: 0.3rem 0.7rem; } }
</style>
</head>
<body>

{# Resolve latest bulletin for direct "This Week" link, avoids bouncing through / #}
{% set latest = collections.bulletins | getLatest %}
{% set latestDate = "" %}
{% set thisWeekUrl = "/" %}
{% if latest %}
  {% set latestDate = latest.data.date | dateToPath %}
  {% set thisWeekUrl = "/" + latestDate + "/" %}
{% endif %}
{% for sb in scrollBulletins %}
  {% if sb.date > latestDate %}
    {% set latestDate = sb.date %}
    {% set thisWeekUrl = sb.url %}
  {% endif %}
{% endfor %}

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="https://fpccorinth.org" target="_blank" rel="noopener">First Presbyterian Church</a>
    <nav class="site-nav" aria-label="Site">
      <details>
        <summary><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>Menu</summary>
        <div class="menu-list">
          <a href="/">This Week’s Bulletin</a>
          <a href="/archive/">Past Bulletins</a>
          <a href="/calendar/">Church Calendar</a>
          <a href="/hymns/">Hymn Index</a>
          <a href="/scripture/">Scripture Index</a>
          <a href="/about/">About &amp; Service Times</a>
        </div>
      </details>
    </nav>
  </div>
</header>

<div class="page">
  <p class="page-eyebrow">Archive</p>
  <h1 class="page-title">Past Bulletins</h1>
  <div class="ornament"></div>

  {# Build combined list of scroll and markdown bulletins #}
  {% set allBulletins = [] %}

  {% for sb in scrollBulletins %}
    {% set allBulletins = (allBulletins.push({date: sb.date, url: sb.url, liturgical_day: sb.liturgical_day, sermon_title: sb.sermon_title, source: "scroll"}), allBulletins) %}
  {% endfor %}

  {% for bulletin in collections.bulletins %}
    {% set sermonTitle = "" %}
    {% if bulletin.data.worship_order %}
      {% for element in bulletin.data.worship_order %}
        {% if element.type == "Sermon" %}
          {% set sermonTitle = element.title %}
        {% endif %}
      {% endfor %}
    {% endif %}
    {% set allBulletins = (allBulletins.push({date: bulletin.data.date | dateToPath, url: "/" + (bulletin.data.date | dateToPath) + "/", liturgical_day: bulletin.data.liturgical_day, sermon_title: sermonTitle, source: "md"}), allBulletins) %}
  {% endfor %}

  {% if allBulletins.length > 0 %}
    <ul class="archive-list">
      {% for item in allBulletins | sort(true, false, "date") %}
        <li data-date="{{ item.date }}">
          <a class="archive-item" href="{{ item.url }}">
            {% if item.liturgical_day %}<p class="archive-day">{{ item.liturgical_day }}</p>{% endif %}
            <p class="archive-date">{{ item.date | formatDate }}</p>
            {% if item.sermon_title %}<p class="archive-sermon">{{ item.sermon_title }}</p>{% endif %}
            <span class="archive-arrow">&rsaquo;</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="empty-state">No bulletins have been published yet.</p>
  {% endif %}

  <p class="page-footer">
    A congregation of the Evangelical Presbyterian Church &middot; <a href="/about/">About</a>
  </p>
</div>

<script>
(function () {
  var items = document.querySelectorAll('.archive-list li[data-date]');
  var ICONS = { apple: '<svg class="app-icon app-icon-applepodcasts" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.34 0A5.328 5.328 0 000 5.34v13.32A5.328 5.328 0 005.34 24h13.32A5.328 5.328 0 0024 18.66V5.34A5.328 5.328 0 0018.66 0zm6.525 2.568c2.336 0 4.448.902 6.056 2.587 1.224 1.272 1.912 2.619 2.264 4.392.12.59.12 2.2.007 2.864a8.506 8.506 0 01-3.24 5.296c-.608.46-2.096 1.261-2.336 1.261-.088 0-.096-.091-.056-.46.072-.592.144-.715.48-.856.536-.224 1.448-.874 2.008-1.435a7.644 7.644 0 002.008-3.536c.208-.824.184-2.656-.048-3.504-.728-2.696-2.928-4.792-5.624-5.352-.784-.16-2.208-.16-3 0-2.728.56-4.984 2.76-5.672 5.528-.184.752-.184 2.584 0 3.336.456 1.832 1.64 3.512 3.192 4.512.304.2.672.408.824.472.336.144.408.264.472.856.04.36.03.464-.056.464-.056 0-.464-.176-.896-.384l-.04-.03c-2.472-1.216-4.056-3.274-4.632-6.012-.144-.706-.168-2.392-.03-3.04.36-1.74 1.048-3.1 2.192-4.304 1.648-1.737 3.768-2.656 6.128-2.656zm.134 2.81c.409.004.803.04 1.106.106 2.784.62 4.76 3.408 4.376 6.174-.152 1.114-.536 2.03-1.216 2.88-.336.43-1.152 1.15-1.296 1.15-.023 0-.048-.272-.048-.603v-.605l.416-.496c1.568-1.878 1.456-4.502-.256-6.224-.664-.67-1.432-1.064-2.424-1.246-.64-.118-.776-.118-1.448-.008-1.02.167-1.81.562-2.512 1.256-1.72 1.704-1.832 4.342-.264 6.222l.413.496v.608c0 .336-.027.608-.06.608-.03 0-.264-.16-.512-.36l-.034-.011c-.832-.664-1.568-1.842-1.872-2.997-.184-.698-.184-2.024.008-2.72.504-1.878 1.888-3.335 3.808-4.019.41-.145 1.133-.22 1.814-.211zm-.13 2.99c.31 0 .62.06.844.178.488.253.888.745 1.04 1.259.464 1.578-1.208 2.96-2.72 2.254h-.015c-.712-.331-1.096-.956-1.104-1.77 0-.733.408-1.371 1.112-1.745.224-.117.534-.176.844-.176zm-.011 4.728c.988-.004 1.706.349 1.97.97.198.464.124 1.932-.218 4.302-.232 1.656-.36 2.074-.68 2.356-.44.39-1.064.498-1.656.288h-.003c-.716-.257-.87-.605-1.164-2.644-.341-2.37-.416-3.838-.218-4.302.262-.616.974-.966 1.97-.97z"/></svg>', spotify: '<svg class="app-icon app-icon-spotify" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>', youtube: '<svg class="app-icon app-icon-youtube" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>' };
  if (!items.length || !window.fetch) return;
  fetch('https://sermons.fpccorinth.org/api/episodes.json')
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (j) {
      if (!j || !j.episodes) return;
      var byDate = {};
      j.episodes.forEach(function (ep) { if (!byDate[ep.date]) byDate[ep.date] = ep; });
      items.forEach(function (li) {
        var ep = byDate[li.getAttribute('data-date')];
        if (!ep) return;
        var a = document.createElement('a');
        a.className = 'archive-listen';
        a.href = ep.url;
        a.target = '_blank';
        a.rel = 'noopener';
        a.title = ep.title + (ep.duration_seconds ? ' (' + Math.round(ep.duration_seconds / 60) + ' min)' : '');
        a.innerHTML = '&#9654;&nbsp; Listen to the sermon';
        li.appendChild(a);
        [['apple', 'Apple Podcasts'], ['spotify', 'Spotify'], ['youtube', 'YouTube']].forEach(function (p) {
          if (!ep.links || !ep.links[p[0]]) return;
          var b = document.createElement('a');
          b.className = 'archive-listen archive-listen-app';
          b.href = ep.links[p[0]]; b.target = '_blank'; b.rel = 'noopener'; b.innerHTML = ICONS[p[0]] + p[1];
          li.appendChild(b);
        });
      });
    })
    .catch(function () {});
})();
</script>

<script>
(function () {
  var d = document.querySelector('.site-nav details');
  if (!d) return;
  document.addEventListener('click', function (e) { if (d.open && !d.contains(e.target)) d.open = false; });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') d.open = false; });
  var p = location.pathname;
  d.querySelectorAll('.menu-list a').forEach(function (a) {
    var h = a.getAttribute('href');
    if (h !== '/' && p.indexOf(h) === 0) a.classList.add('current');
  });
})();
</script>
</body>
</html>
