# User-level systemd unit for the FPC bulletin builder (same pattern as fpc-sermons).
# Install:  cp builder/deploy/bulletin-builder.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now bulletin-builder
# Logs:     journalctl --user -u bulletin-builder -f
[Unit]
Description=FPC Corinth bulletin builder web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/bulletin-builder/repo
EnvironmentFile=%h/.config/bulletin-builder/env
Environment=BUILDER_REPO=%h/bulletin-builder/repo
Environment=BUILDER_VAR=%h/bulletin-builder/var
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/bulletin-builder/venv/bin/uvicorn builder.app.main:app --host 127.0.0.1 --port 8710 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
SyslogIdentifier=bulletin-builder

[Install]
WantedBy=default.target
